rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validSite() {
      return request.resource.data.site == "keepswagalive.com";
    }

    match /fanMembers/{document} {
      allow create: if
        validSite() &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'source',
          'type',
          'createdAt',
          'site'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.source is string &&
        request.resource.data.type is string;
      
      allow read, update, delete: if false;
    }

    match /bookings/{document} {
      allow create: if
        validSite() &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'event',
          'location',
          'message',
          'status',
          'createdAt',
          'site'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.event is string &&
        request.resource.data.location is string &&
        request.resource.data.message is string &&
        request.resource.data.status == "new";

      allow read, update, delete: if false;
    }

    match /payments/{document} {
      allow create: if
        validSite() &&
        request.resource.data.keys().hasOnly([
          'orderNumber',
          'customerName',
          'customerEmail',
          'product',
          'paymentMethod',
          'receiptUrl',
          'receiptPath',
          'status',
          'createdAt',
          'site'
        ]) &&
        request.resource.data.orderNumber is string &&
        request.resource.data.customerName is string &&
        request.resource.data.customerEmail is string &&
        request.resource.data.product is string &&
        request.resource.data.paymentMethod is string &&
        request.resource.data.receiptUrl is string &&
        request.resource.data.receiptPath is string &&
        request.resource.data.status == "pending_verification";

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}