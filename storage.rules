rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /payment-receipts/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if false;
      allow delete: if false;
    }
  }
}
